

### variables
@port = 8080
@token = ddf23e01-ecf8-4c02-bb82-186c140247eb
@user_id = 58a90a10-2423-4457-91e5-c276f87bbe71

### Register a User
### /register

POST http://localhost:{{port}}/register
Accept: application/json
Content-Type: application/json

{
    "email": "user2@koodsisu.fi",
    "name": "user two",
    "password": "User@2"
}


### GET User
### /user/{id}
GET http://localhost:{{port}}/user/{{user_id}}
Accept: application/json


### Login a User
### /login

POST http://localhost:{{port}}/login
Accept: application/json
Content-Type: application/json

{
    "email": "user2@koodsisu.fi",
    "password": "User@2"
}

### Logout a User
### /logout

POST http://localhost:{{port}}/logout
Accept: application/json
Content-Type: application/json

{
    "user_id": "{{user_id}}",
    "token": "{{token}}"
}

### Insert Todo User
### /todo
POST http://localhost:{{port}}/user/todo
Accept: application/json
Content-Type: application/json

{
    "user_id": "{{user_id}}",
    "content": "Do the task for today and tomorrow edit again",
    "due_time": null
}

### Update Todo User
### /todo
PUT http://localhost:{{port}}/user/todo
Accept: application/json
Content-Type: application/json

{
    "id": 1,
    "content": "try to change this todo?",
    "due_time": "2025-11-15T19:23:00Z"
}

### Get todo user
### /todo/{id}
GET http://localhost:{{port}}/user/todo/{{user_id}}
Accept: application/json